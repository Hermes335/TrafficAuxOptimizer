# Template only: use your backend host's environment settings for production.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=change-to-a-unique-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=change-to-another-unique-random-secret-of-at-least-32-characters
ALLOWED_HOSTS=api.your-domain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=https://api.your-domain.com
# True ONLY behind a trusted proxy that replaces X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
TOMTOM_API_KEY=
# Persistent private upload directory; never place inside MEDIA_ROOT or serve publicly.
PRIVATE_MEDIA_ROOT=/var/incident-photos
# Worker/broker/result backend default to REDIS_URL; override if needed.
