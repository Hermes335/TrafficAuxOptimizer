# Database
DATABASE_URL=postgis://postgres:postgres@postgres:5432/traffic_dss
POSTGIS_VERSION=3.4

# Redis
REDIS_URL=redis://redis:6379/0

# External APIs
TOMTOM_API_KEY=your_tomtom_key
OPENWEATHERMAP_API_KEY=your_weather_key
PAGASA_API_ENDPOINT=https://api.pagasa.dost.gov.ph
ILOILO_LATITUDE=10.7202
ILOILO_LONGITUDE=122.5621

# Django Settings
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# File Upload
MAX_UPLOAD_SIZE=10485760

# Security
JWT_SECRET_KEY=change-me-jwt
JWT_ALGORITHM=HS256

# Logging
LOG_DIR=/var/log/traffic_dss