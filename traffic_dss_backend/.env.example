# Database
DATABASE_URL=postgis://postgres:postgres@localhost:5432/traffic_dss
POSTGIS_VERSION=3.4

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
# Open-Meteo is free and does not need a key.
TOMTOM_API_KEY=your_tomtom_key
PAGASA_API_ENDPOINT=https://api.pagasa.dost.gov.ph
ILOILO_LATITUDE=10.7202
ILOILO_LONGITUDE=122.5621

# Django Settings
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Upload
MAX_UPLOAD_SIZE=10485760

# Security
JWT_SECRET_KEY=change-me-jwt
JWT_ALGORITHM=HS256

# Logging
LOG_DIR=./logs
