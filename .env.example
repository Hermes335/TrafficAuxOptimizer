# Public frontend configuration, embedded into the browser bundle at build time.
# Copy to .env.web.local for a local web build, or set in Vercel project settings.
# Replace the example origin with your hosted Django API. Do not append /api.
VITE_API_BASE_URL=https://api.your-domain.com

# Put database credentials, Redis credentials, SECRET_KEY, JWT_SECRET_KEY,
# and TOMTOM_API_KEY only in the backend host's environment. Never prefix secrets with VITE_.
